       "id": "877a9ba",
       "elType": "widget",
       "widgetType": "html",
       "settings": {
        "html": "<form action=\"#\" method=\"post\" style=\"display:grid;gap:16px;grid-template-columns:1fr 1fr\">\n<label style=\"display:block;font:12px Inter,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#a9a9ae;margin-bottom:6px\">Nom<input name=\"nom\" required placeholder=\"El teu nom\" style=\"width:100%;box-sizing:border-box;padding:13px 14px;background:#1a1a1d;border:1px solid rgba(255,255,255,.12);color:#fff;font:14px Inter,sans-serif;border-radius:2px;margin-top:6px\"></label>\n<label style=\"display:block;font:12px Inter,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#a9a9ae;margin-bottom:6px\">Telèfon<input name=\"tel\" type=\"tel\" placeholder=\"600 00 00 00\" style=\"width:100%;box-sizing:border-box;padding:13px 14px;background:#1a1a1d;border:1px solid rgba(255,255,255,.12);color:#fff;font:14px Inter,sans-serif;border-radius:2px;margin-top:6px\"></label>\n<label style=\"display:block;font:12px Inter,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#a9a9ae;margin-bottom:6px;grid-column:1/-1\">Correu electrònic<input name=\"email\" type=\"email\" required placeholder=\"nom@correu.com\" style=\"width:100%;box-sizing:border-box;padding:13px 14px;background:#1a1a1d;border:1px solid rgba(255,255,255,.12);color:#fff;font:14px Inter,sans-serif;border-radius:2px;margin-top:6px\"></label>\n<label style=\"display:block;font:12px Inter,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#a9a9ae;margin-bottom:6px;grid-column:1/-1\">Què t'interessa?<select name=\"tipus\" style=\"width:100%;box-sizing:border-box;padding:13px 14px;background:#1a1a1d;border:1px solid rgba(255,255,255,.12);color:#fff;font:14px Inter,sans-serif;border-radius:2px;margin-top:6px\"><option>Finestres</option><option>Portes d'entrada</option><option>Persianes</option><option>Pèrgoles i exteriors</option><option>Baranes i mampares</option><option>Altres</option></select></label>\n<label style=\"display:block;font:12px Inter,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#a9a9ae;margin-bottom:6px;grid-column:1/-1\">Missatge<textarea name=\"missatge\" rows=\"5\" placeholder=\"Explica'ns breument el teu projecte\" style=\"width:100%;box-sizing:border-box;padding:13px 14px;background:#1a1a1d;border:1px solid rgba(255,255,255,.12);color:#fff;font:14px Inter,sans-serif;border-radius:2px;margin-top:6px\"></textarea></label>\n<label style=\"grid-column:1/-1;font:12px Inter,sans-serif;color:#cfcfd2\"><input type=\"checkbox\" required> He llegit i accepto la política de privacitat.</label>\n<button type=\"submit\" style=\"grid-column:1/-1;justify-self:start;padding:15px 28px;background:#e4152d;color:#fff;border:0;border-radius:2px;font:600 12px Inter,sans-serif;letter-spacing:.08em;text-transform:uppercase;cursor:pointer\">Demana pressupost &rarr;</button></form>"
